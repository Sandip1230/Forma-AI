PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/forma-ai

GOOGLE_API_KEY=your-gemini-api-key-here

JWT_SECRET=generate-a-long-random-string-here
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# POST /api/auth/dev-login skips signup/OTP/password and logs into a fixed
# test account — local dev convenience only. Never set this to true on a
# real deployment. Defaults to disabled (404) unless explicitly "true".
ALLOW_DEV_LOGIN=false